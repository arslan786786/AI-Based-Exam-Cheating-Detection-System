# Flask Configuration
FLASK_ENV=development
FLASK_APP=backend/app.py

# Security Keys (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database Configuration
# For SQLite (default):
# DATABASE_URL=sqlite:///exam_proctoring.db

# For PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/exam_db

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Webcam Settings
WEBCAM_FPS=2
FRAME_WIDTH=640
FRAME_HEIGHT=480

# Detection Thresholds
HEAD_TURN_ANGLE_THRESHOLD=30
HEAD_TURN_DURATION_THRESHOLD=5
GAZE_DEVIATION_THRESHOLD=0.3
FACE_MISSING_THRESHOLD=3

# Scoring Weights
SCORE_NO_FACE=30
SCORE_MULTIPLE_FACES=40
SCORE_HEAD_MOVEMENT=15
SCORE_EYE_GAZE_DEVIATION=10
SCORE_MOBILE_PHONE=50

# Risk Thresholds
RISK_LOW_THRESHOLD=30
RISK_MEDIUM_THRESHOLD=60
RISK_HIGH_THRESHOLD=100
